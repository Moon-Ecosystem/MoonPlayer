<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch splash: match the app's background so the icon sits on the same
         dark as the first screen instead of the system default. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">#121212</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#121212</item>
    </style>
</resources>
